+CTable.prototype.ApplyTableGridBorders = function()
+{
+	// Quick Look omits borders inherited from Table Grid. Materialize them
+	// when inserting a table or explicitly applying that style, not on load.
+	if (this.bPresentation || AscCommon.g_oIdCounter.m_bLoad || AscCommon.g_oIdCounter.m_bRead)
+		return;
+
+	var styles = this.Get_Styles();
+	if (!styles || !this.TableStyle || this.TableStyle !== styles.Get_Default_TableGrid())
+		return;
+
+	var borders = this.Get_CompiledPr(false).TablePr.TableBorders;
+	var sides = ["Top", "Bottom", "Left", "Right", "InsideH", "InsideV"];
+	for (var i = 0; i < sides.length; ++i)
+	{
+		var side = sides[i];
+		if (undefined === this.Pr.TableBorders[side] && undefined !== borders[side])
+			this["Set_TableBorder_" + side](borders[side]);
+	}
 };
